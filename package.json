{
    "name":  "dsh-porter",
    "version":  "0.2.0",
    "description":  "DSH session data ops: cross-root migrate (cwd convert), inspect, repair, format convert. Zero dsh dependency.",
    "type":  "module",
    "bin":  {
                "dsh-porter":  "src/cli.js"
            },
    "main":  "src/index.js",
    "files":  [
                  "src/",
                  "README.md",
                  "LICENSE",
                  "SPEC.md",
                  "docs/",
                  "examples/"
              ],
    "engines":  {
                    "node":  "\u003e=20.11"
                },
    "scripts":  {
                    "test":  "node --test test/dsh-porter.test.js test/cli.test.js"
                },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "session",
                     "migrate",
                     "zstd"
                 ],
    "license":  "MIT",
    "dependencies":  {
                         "fzstd":  "^0.1.1",
                         "@bokuweb/zstd-wasm":  "^0.0.27"
                     }
}
